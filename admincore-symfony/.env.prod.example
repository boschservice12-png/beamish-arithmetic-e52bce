# Flotta-riport e-mailben (app:fleet-report:send; ütemező: docker compose --profile fleet-report up -d)
# Az SMTP-jelszó titok: csak itt, a szerveren. Port 587 + STARTTLS; a feladó domainjén SPF + DKIM legyen beállítva.
MAILER_DSN=null://null
FLEET_REPORT_FROM="TyreFleet <raport@cegem.ro>"
FLEET_REPORT_TO=
FLEET_REPORT_CC=
FLEET_REPORT_INPUT=var/share/fleet-report/in/flota.json
FLEET_REPORT_DAY=1
FLEET_REPORT_HOUR=08:00
FLEET_REPORT_KINDS=month,quarter,year
FLEET_REPORT_CLIENT_TO=          # B2B riport a flotta-ügyfélnek (üresen kimarad)
FLEET_REPORT_CLIENT_CC=
FLEET_REPORT_BRAND=config/fleet-report/brand.json
