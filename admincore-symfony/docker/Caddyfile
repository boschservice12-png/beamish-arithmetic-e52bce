{
	frankenphp
	admin off
	auto_https off
	{$CADDY_GLOBAL_OPTIONS}
}

{$SERVER_NAME::8080} {
	root * /app/public
	encode zstd gzip

	# Hozzáférési napló JSON-ban a stdout-ra → központi naplógyűjtő (Promtail/Loki)
	log {
		output stdout
		format json
	}

	# Az asset-URL-ek tartalom-hash-t hordoznak (?v=…) → hosszan cache-elhetők
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header -Server

	php_server
}
