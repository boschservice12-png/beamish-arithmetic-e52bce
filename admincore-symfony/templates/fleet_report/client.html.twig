{# B2B flotta-riport: a szerviz küldi a flotta-ügyfélnek, a szerviz arculatával. Csak az ügyfélnek szóló adat:
   műveletek, gumiállapot, depó, ajánlások — belső keret, üzemanyag-gyanú és sofőrnév nincs benne. Dompdf: csak táblázat. #}
{% set st = r.state %}{% set col = brand.color %}
<!doctype html>
<html lang="ro">
<head>
<meta charset="utf-8">
<title>{{ brand.name }} · Raport flotă · {{ r.fleetName }} · {{ r.period.label }}</title>
<style>
@page { size: A4; margin: 14mm 12mm 16mm; }
body { font-family: "DejaVu Sans", sans-serif; font-size: 9pt; color: #1b1d22; line-height: 1.4; margin: 0; }
h1 { font-size: 17pt; margin: 0; }
h2 { font-size: 11pt; margin: 0 0 6px; color: {{ col }}; }
table { width: 100%; border-collapse: collapse; }
tr { page-break-inside: avoid; }
.mute { color: #646a75; }
.brand { border-bottom: 3pt solid {{ col }}; padding-bottom: 8px; margin-bottom: 10px; }
.bname { font-size: 15pt; font-weight: bold; color: {{ col }}; }
.eyebrow { font-size: 7.5pt; letter-spacing: 1.2px; text-transform: uppercase; color: {{ col }}; font-weight: bold; }
.lead { font-size: 10pt; margin: 4px 0 10px; }
.kpis td { width: 25%; border: 1pt solid #dfe2e7; padding: 7px 9px; vertical-align: top; }
.kv { font-size: 15pt; font-weight: bold; }
.kv.red { color: #c8102e; } .kv.amb { color: #8a5200; } .kv.ok { color: #16733a; }
.kl { font-size: 7.6pt; color: #646a75; }
.card { border: 1pt solid #dfe2e7; padding: 8px 10px; margin-bottom: 9px; }
.card.hl { border-color: {{ col }}; background: {{ brand.colorSoft }}; }
.t td, .t th { padding: 3.5px 4px; border-bottom: 0.6pt solid #dfe2e7; text-align: left; vertical-align: top; }
.t th { font-size: 7pt; color: #646a75; text-transform: uppercase; letter-spacing: .5px; }
.r { text-align: right !important; white-space: nowrap; }
.mono { font-family: "DejaVu Sans Mono", monospace; }
.pill { font-weight: bold; font-size: 7.6pt; padding: 1px 6px; border-radius: 7px; }
.p-now { background: #fde8eb; color: #c8102e; } .p-soon { background: #fff1d9; color: #8a5200; } .p-ok { background: #e3f5ea; color: #16733a; }
.n { font-weight: bold; font-size: 10pt; } .n.red { color: #c8102e; } .n.amb { color: #a86400; } .n.ok { color: #16833f; }
.act td { padding: 5px 4px; border-bottom: 0.6pt solid #e6d3d6; vertical-align: top; }
.cta { background: {{ col }}; color: #fff; padding: 9px 12px; font-size: 10pt; }
.cta b { color: #fff; }
.foot { font-size: 7pt; color: #646a75; border-top: 0.6pt solid #dfe2e7; padding-top: 5px; margin-top: 8px; }
</style>
</head>
<body>
<table class="brand"><tr>
  <td style="vertical-align: middle">{% if brand.logoDataUri %}<img src="{{ brand.logoDataUri }}" alt="{{ brand.name }}" style="height: 34px">{% else %}<span class="bname">{{ brand.name }}</span>{% endif %}</td>
  <td class="r mute" style="font-size: 7.6pt; vertical-align: middle">{{ brand.legalName }}{% if brand.cui %} · CUI {{ brand.cui }}{% endif %}<br>{{ brand.contactLine }}</td>
</tr></table>

<div class="eyebrow">Raport flotă · {{ r.period.kind == 'month' ? 'lunar' : (r.period.kind == 'quarter' ? 'trimestrial' : 'anual') }}</div>
<h1>{{ r.fleetName }} · {{ r.period.label }}</h1>
{% set opsCost = r.operations|reduce((s, o) => s + o.cost, 0) %}
<p class="lead">{% if r.operations %}În {{ r.period.label }} am efectuat <b>{{ r.operations|length }}</b> {{ r.operations|length == 1 ? 'operațiune' : 'operațiuni' }} pentru flota dumneavoastră{% if opsCost > 0 %} (<b>{{ opsCost|lei }}</b> fără TVA){% endif %}.{% else %}Starea flotei dumneavoastră după {{ r.period.label }}.{% endif %}
  Din {{ r.vehicleCount }} vehicule: <b>{{ st.tyres.ok }}</b> în regulă, <b>{{ st.tyres.soon }}</b> se apropie de schimb, <b>{{ st.tyres.now }}</b> necesită schimb acum.
  {% if st.storedSets %}<b>{{ st.storedSets }}</b> seturi sunt depozitate.{% endif %}</p>

<table class="kpis"><tr>
  <td><div class="kv">{{ r.operations|length }}</div><div class="kl">operațiuni în perioadă</div></td>
  <td><div class="kv {{ st.tyres.now ? 'red' : 'ok' }}">{{ st.tyres.now }}</div><div class="kl">vehicule cu anvelope de schimbat acum</div></td>
  <td><div class="kv {{ st.summerTyresInWinter ? 'red' : 'ok' }}">{{ st.summerTyresInWinter|length }}</div><div class="kl">vehicule pe anvelope de vară iarna</div></td>
  <td><div class="kv">{{ st.tyreOrders3m.count }}</div><div class="kl">seturi noi în 3 luni · {{ st.tyreOrders3m.cost|lei }}</div></td>
</tr></table>
<div style="height: 9px"></div>

<div class="card hl"><h2>Ce vă recomandăm</h2>
<table class="act">{% for a in actions %}<tr><td style="width: 18px"><span class="n {{ a.level }}">{{ a.level == 'ok' ? '✓' : loop.index ~ '.' }}</span></td><td>{{ a.text }}</td></tr>{% endfor %}</table></div>

{% set rank = {'now': 0, 'soon': 1, 'ok': 2} %}
{% set veh = r.vehicles|sort((a, b) => ((rank[a.tyres.status ?? 'ok'] ?? 3) <=> (rank[b.tyres.status ?? 'ok'] ?? 3)) ?: (a.plate <=> b.plate)) %}
<div class="card"><h2>Starea anvelopelor pe vehicul · la {{ r.generatedAt|date('d.m.Y') }}</h2>
<table class="t"><tr><th>Vehicul</th><th>Model</th><th>Sezon</th><th class="r">Min. mm</th><th>Stare</th><th class="r">Schimb estimat</th></tr>
{% for v in veh %}{% set t = v.tyres %}
<tr><td class="mono"><b>{{ v.plate }}</b></td><td class="mute">{{ v.model }}</td>
{% if t %}<td>{{ t.season == 'iarna' ? 'iarnă' : 'vară' }}{{ t.season == 'vara' and v.plate in st.summerTyresInWinter ? ' ⚠' : '' }}</td><td class="r mono">{{ t.minMm|num(1) }}</td>
<td><span class="pill p-{{ t.status }}">{{ {'now': 'schimb acum', 'soon': 'curând', 'ok': 'în regulă'}[t.status] }}</span></td><td class="r">{{ t.replaceBy ? t.replaceBy|rodate : '—' }}</td>
{% else %}<td colspan="4" class="mute">fără măsurători</td>{% endif %}</tr>
{% endfor %}</table>
<div class="mute" style="font-size: 7.4pt">Praguri de schimb: vară 2,5 mm · iarnă 3,0 mm · utilitare 2,5 mm (minim legal 1,6 mm). „Schimb estimat” = din uzura măsurată și kilometrajul lunar.</div></div>

<div class="card"><h2>Operațiuni efectuate · {{ r.period.label }}</h2>
{% if r.operations %}<table class="t"><tr><th>Data</th><th>Vehicul</th><th>Operațiune</th><th class="r">Cost (fără TVA)</th></tr>
{% for o in r.operations %}<tr><td class="mono">{{ o.date|rodate }}</td><td class="mono">{{ o.plate }}</td><td>{{ o.type }}</td><td class="r mono">{{ o.cost ? o.cost|lei : '—' }}</td></tr>{% endfor %}</table>
{% else %}<div class="mute">Nicio operațiune în această perioadă.</div>{% endif %}</div>

{% if brand.contactLine %}<table><tr><td class="cta">Programări și oferte: <b>{{ brand.contactLine }}</b></td></tr></table>{% endif %}

<div class="foot">Raport întocmit de {{ brand.legalName }}{% if brand.cui %} (CUI {{ brand.cui }}{% if brand.regcom %}, {{ brand.regcom }}{% endif %}){% endif %}{% if brand.address %}, {{ brand.address }}{% endif %} pentru {{ r.fleetName }}, din datele înregistrate în TyreFleet.
Starea anvelopelor este la data generării ({{ r.generatedAt|date('d.m.Y') }}); estimările nu înlocuiesc verificarea la service. Sume în lei, fără TVA.</div>
</body>
</html>
