        </div>
        <button onclick="ganttPrev()" style="padding:5px 10px;background:var(--white);border:1px solid var(--border);border-radius:6px;cursor:pointer;font-size:.85rem;font-weight:700;">&larr;</button>
        <button onclick="ganttToday()" style="padding:5px 12px;background:var(--red);color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:.72rem;font-weight:700;font-family:inherit;">Azi</button>
        <button onclick="ganttNext()" style="padding:5px 10px;background:var(--white);border:1px solid var(--border);border-radius:6px;cursor:pointer;font-size:.85rem;font-weight:700;">&rarr;</button>
        <input type="date" id="ganttDatePicker" onchange="ganttDate=new Date(this.value+'T12:00:00');renderGantt();" style="padding:4px 8px;font-size:.72rem;border:1px solid var(--border);border-radius:5px;font-family:inherit;">
