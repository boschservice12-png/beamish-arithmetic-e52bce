# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> admincore ###
# A Supabase projekt (ugyanaz, mint a v33 HTML-ben). A publishable kulcs nyilvános
# kliens-kulcs, a böngészőbe kerül; service_role kulcsot SOHA ne írj ide.
ADMINCORE_SUPABASE_URL=https://zwsjfzqtskicrukidaog.supabase.co
ADMINCORE_SUPABASE_KEY=sb_publishable_Yu-prB2M7ZUtWiWxeV8LDg_6LINloIU
ADMINCORE_SUPABASE_SDK=https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2
# 1 = a böngésző a saját domainen (/sb) át éri el a Supabase-t: engedélylista + auditnapló.
# 0 = közvetlen Supabase-hívás, mint a v33-ban (azonnali visszaállás).
ADMINCORE_GATEWAY=1
# Automatikus ASM-import (POST /api/asm/import) — alapból KI. Bekapcsoláshoz mindkettő a .env.local-ba (titok!):
#   ASM_API_TOKEN=<hosszú véletlen token az ASM-oldali feltöltőnek>
#   ADMINCORE_SUPABASE_SERVICE_KEY=<Supabase service_role / secret kulcs — csak szerveren>
# Reverse proxy / Cloudflare mögött a proxy IP-címe(i), pl. 127.0.0.1,REMOTE_ADDR — üresen: nincs proxy.
TRUSTED_PROXIES=
# Prometheus /metrics: üresen KI (404). Bekapcsoláshoz hosszú véletlen token a .env.local-ba / szerver-env-be.
METRICS_TOKEN=
###< admincore ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
